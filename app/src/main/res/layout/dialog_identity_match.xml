<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#333333">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/identity_match_title"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/dialog_msg_prefix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/identity_match_msg_prefix"
        android:textColor="#DDDDDD"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/matched_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ws://example.com/user/net"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="italic"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/btn_choose_other"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wrong_detection_tip"
            android:textColor="#00BCD4"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/identity_match_msg_suffix"
        android:textColor="#DDDDDD"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_no_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/identity_match_no"
            android:textColor="#BBBBBB"
            android:background="@drawable/btn_border_gray"
            android:layout_marginEnd="12dp"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btn_yes_persist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/identity_match_yes"
            android:textColor="#BB86FC"
            android:background="@drawable/btn_border_purple"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
</LinearLayout>
